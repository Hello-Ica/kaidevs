{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/(css|assets)/(.*)", "dest": "/$1/$2" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}